{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "zsh -lc 'javac *.java && java Server ${input:serverArgs}; status=$?; echo; echo \"Process exited with status $status. Press Enter to close.\"; read _; exit $status'",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run Client",
      "type": "node-terminal",
      "request": "launch",
      "command": "zsh -lc 'javac *.java && java Client ${input:clientSeat}; status=$?; echo; echo \"Process exited with status $status. Press Enter to close.\"; read _; exit $status'",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Server (Java Launch)",
      "type": "java",
      "request": "launch",
      "mainClass": "runners.ServerRunner",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": "${input:serverArgs}",
      "sourcePaths": [
        "${workspaceFolder}/src/main/java"
      ],
      "classPaths": [
        "${workspaceFolder}/build/javac-main/classes",
        "${workspaceFolder}/src/main/resources"
      ],
      "preLaunchTask": "javac: compile"
    },
    {
      "name": "Debug Client (Java Launch)",
      "type": "java",
      "request": "launch",
      "mainClass": "runners.ClientRunner",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": "${input:clientSeat}",
      "sourcePaths": [
        "${workspaceFolder}/src/main/java"
      ],
      "classPaths": [
        "${workspaceFolder}/build/javac-main/classes",
        "${workspaceFolder}/src/main/resources"
      ],
      "preLaunchTask": "javac: compile"
    }
  ],
  "inputs": [
    {
      "id": "serverArgs",
      "type": "pickString",
      "description": "Server options",
      "default": "",
      "options": [
        "",
        "--single-client",
        "1",
        "2",
        "3",
        "4",
        "--fresh",
        "--fresh --no-ui",
        "--single-client --fresh",
        "--single-client --fresh --no-ui",
        "1 --fresh",
        "1 --fresh --no-ui",
        "2 --fresh",
        "2 --fresh --no-ui",
        "3 --fresh",
        "3 --fresh --no-ui",
        "4 --fresh",
        "4 --fresh --no-ui"
      ]
    },
    {
      "id": "clientSeat",
      "type": "pickString",
      "description": "Client seat",
      "default": "REBEL_1",
      "options": [
        "REBEL_1",
        "REBEL_2",
        "REBEL_3",
        "REBEL_4",
        "IMPERIAL"
      ]
    }
  ]
}
