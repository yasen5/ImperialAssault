{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "javac: compile",
      "type": "shell",
      "command": "javac *.java",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "java: runServer",
      "type": "shell",
      "command": "java Server ${input:serverArgs}",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "java: runClient",
      "type": "shell",
      "command": "java Client ${input:clientSeat}",
      "group": "test",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "serverArgs",
      "type": "pickString",
      "description": "Server options",
      "default": "",
      "options": [
        "",
        "--single-client",
        "1",
        "2",
        "3",
        "4",
        "--fresh",
        "--fresh --no-ui",
        "--single-client --fresh",
        "--single-client --fresh --no-ui",
        "1 --fresh",
        "1 --fresh --no-ui",
        "2 --fresh",
        "2 --fresh --no-ui",
        "3 --fresh",
        "3 --fresh --no-ui",
        "4 --fresh",
        "4 --fresh --no-ui"
      ]
    },
    {
      "id": "clientSeat",
      "type": "pickString",
      "description": "Client seat",
      "default": "REBEL_1",
      "options": [
        "REBEL_1",
        "REBEL_2",
        "REBEL_3",
        "REBEL_4",
        "IMPERIAL"
      ]
    }
  ]
}
